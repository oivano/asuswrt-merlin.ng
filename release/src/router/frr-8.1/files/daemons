# Compiled daemons for AsusWRT FRR build:
# zebra, bgpd, ospfd, staticd, bfdd, watchfrr
#
zebra=yes
bgpd=yes
ospfd=yes
staticd=yes
bfdd=yes

#
# If this option is set the /usr/sbin/frr script automatically loads
# the config via "vtysh -b" when the servers are started.
# Configuration file is /etc/frr.conf
#
vtysh_enable=yes
zebra_options=" -s 90000000 --daemon"
bgpd_options=" --daemon"
ospfd_options=" --daemon"
staticd_options=" --daemon"
bfdd_options=" --daemon"

# The list of daemons to watch is automatically generated by the init script.
#watchfrr_options=""
#   ospfd_wrap="/usr/bin/valgrind"
# or you can use "all_wrap" for all daemons, e.g. to use perf record:
#   all_wrap="/usr/bin/perf record --call-graph -"
# the normal daemon command is added to this at the end.
