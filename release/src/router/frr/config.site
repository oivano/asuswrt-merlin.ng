# ----------------------------------------------------------------
# Target (ARM) compiler and flags (default)
# ----------------------------------------------------------------
export STAGEDIR=/home/docker/project/release/src-rt-6.x.4708/router/arm-uclibc/stage
export TOP=/home/docker/project/release/src-rt-6.x.4708/router

CC=arm-brcm-linux-uclibcgnueabi-gcc
CXX=arm-brcm-linux-uclibcgnueabi-g++
AR=arm-brcm-linux-uclibcgnueabi-ar
RANLIB=arm-brcm-linux-uclibcgnueabi-ranlib
LD=arm-brcm-linux-uclibcgnueabi-ld

CFLAGS="-Os -pipe -ffunction-sections -fdata-sections -fPIC -std=gnu99"
LDFLAGS="-L$TOP/ncurses-6.0/lib -lncurses -L$STAGEDIR/usr/lib -lreadline -ljson-c -lpcre -lyang -ffunction-sections -fdata-sections -Wl,--gc-sections -Wl,-rpath-link,$STAGEDIR/usr/lib" 

LIBREADLINE_CFLAGS="-I$STAGEDIR/usr/include"
LIBREADLINE_LIBS="-L$STAGEDIR/usr/lib -lreadline -lncurses"

JSON_C_CFLAGS="-I$STAGEDIR/usr/include/json-c"
JSON_C_LIBS="-L$STAGEDIR/usr/lib -ljson-c"

# ----------------------------------------------------------------
# Override: use native compiler for hosttools / clippy
# ----------------------------------------------------------------
case "$ac_pwd" in
    */build/hosttools|*/build-clippy)
        # Use native compiler for host build
        export CC=/usr/bin/gcc
        export CXX=/usr/bin/g++
        export CPPFLAGS=""
        export CFLAGS="-O2 -pipe"
        export LDFLAGS=""
        export AR=""
        export LD=""
        export RANLIB=""
        export HOST_CC=/usr/bin/gcc
        export HOST_CXX=/usr/bin/g++
        export HOST_CPPFLAGS=""
        export HOST_CFLAGS="-O2 -pipe"
        export HOST_LDFLAGS=""

        # Use native Python paths for host build
        export PYTHON=/usr/bin/python3
        export PYTHON_CONFIG=/usr/bin/python3-config

        # Export flags so configure sees them
        export PYTHON_CFLAGS="$($PYTHON_CONFIG --includes)"
        export PYTHON_LIBS="$($PYTHON_CONFIG --libs) -lpython3.8"
        ;;
esac