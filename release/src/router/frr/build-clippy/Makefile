# overwriting these vars breaks cross-compilation.  let's be helpful and warn.
#
# note: "#AUTODERP# " will be removed from Makefile by configure.  These are
# GNU make directives & automake will f*ck them up by trying to process them
# as automake directives.
#
null=
SPACE=$(null) $(null)
mkcheck_CC =       $(findstring $(SPACE)CC=,      $(SPACE)$(MAKEOVERRIDES))
mkcheck_CFLAGS =   $(findstring $(SPACE)CFLAGS=,  $(SPACE)$(MAKEOVERRIDES))
mkcheck_CPPFLAGS = $(findstring $(SPACE)CPPFLAGS=,$(SPACE)$(MAKEOVERRIDES))
mkcheck_CCLD =     $(findstring $(SPACE)CCLD=,    $(SPACE)$(MAKEOVERRIDES))
mkcheck_LD =       $(findstring $(SPACE)LD=,      $(SPACE)$(MAKEOVERRIDES))
mkcheck_LDFLAGS =  $(findstring $(SPACE)LDFLAGS=, $(SPACE)$(MAKEOVERRIDES))
#
ifneq ($(mkcheck_CC),)
  $(warning WARNING: you have overwritten the "CC" variable on the make command line.)
endif
ifneq ($(mkcheck_CFLAGS),)
  $(warning WARNING: you have overwritten the "CFLAGS" variable on the make command line.)
endif
ifneq ($(mkcheck_CPPFLAGS),)
  $(warning WARNING: you have overwritten the "CPPFLAGS" variable on the make command line.)
endif
ifneq ($(mkcheck_CCLD),)
  $(warning WARNING: you have overwritten the "CCLD" variable on the make command line.)
endif
ifneq ($(mkcheck_LD),)
  $(warning WARNING: you have overwritten the "LD" variable on the make command line.)
endif
ifneq ($(mkcheck_LDFLAGS),)
  $(warning WARNING: you have overwritten the "LDFLAGS" variable on the make command line.)
endif
#
ifneq ($(mkcheck_CC)$(mkcheck_CFLAGS)$(mkcheck_CPPFLAGS)$(mkcheck_CCLD)$(mkcheck_LD)$(mkcheck_LDFLAGS),)
  $(warning ------)
  $(warning While overwriting these variables works most of the time, it is not recommended and can cause confusing build errors.)
  $(warning This is especially problematic when cross-compiling, since tools that run on the build system during the build process will not be compiled correctly.)
  $(warning All of these variables should be supplied to 'configure', and they will be remembered and correctly applied during 'make'.)
  $(warning ------)
endif

